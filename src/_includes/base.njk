{% import "macros.njk" as m %}<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if seccion == "inicio" %}{{ site.nombre }}{% else %}{{ title }} · {{ site.nombre }}{% endif %}</title>
  <meta name="description" content="{{ descripcion or site.descripcion }}">
  {% if site.borrador %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <meta name="theme-color" content="#2e6a50">
  <script>
    // Aplica el tema elegido antes de pintar la página, para que no parpadee.
    try { var t = localStorage.getItem("tema"); if (t === "claro" || t === "oscuro") document.documentElement.dataset.tema = t; } catch (e) {}
    // Activa las animaciones salvo que el visitante haya pedido «reducir movimiento».
    // Si el script principal no llegara a cargar, se desactivan para que nada se quede oculto.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("anima");
      setTimeout(function () { if (!window.animacionesListas) document.documentElement.classList.remove("anima"); }, 2500);
    }
  </script>
  <link rel="preload" href="/assets/fuentes/figtree.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fuentes/fraunces.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/estilos.css">
  <script src="/assets/js/main.js" defer></script>
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <div class="progreso" aria-hidden="true"></div>

  {% if site.borrador %}
  <div class="borrador" role="note">
    <strong>Propuesta de web</strong> · versión de prueba, no oficial. Los horarios pueden no estar actualizados.
  </div>
  {% endif %}

  <header class="cabecera">
    <div class="contenedor cabecera__fila">
      <a class="marca" href="/">
        {{ m.iglesia("marca__icono") }}
        <span class="marca__texto">
          <span class="marca__pre">Unidad Pastoral</span>
          <span class="marca__nombre">Infiesto</span>
        </span>
      </a>
      <button class="boton-tema" type="button" id="boton-tema" aria-label="Cambiar a modo oscuro" title="Modo claro / oscuro">
        <svg class="icono-luna" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.7 14.6A8.5 8.5 0 0 1 9.4 3.3a.6.6 0 0 0-.8-.7A9.7 9.7 0 1 0 21.4 15.4a.6.6 0 0 0-.7-.8Z"/></svg>
        <svg class="icono-sol" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
    <nav class="pestanas" aria-label="Principal">
      <ul class="contenedor pestanas__lista">
        {% for item in navegacion %}
        <li><a href="{{ item.url }}"{% if item.id == seccion %} aria-current="page"{% endif %}>{{ item.titulo }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </header>

  {% if seccion == "inicio" %}
    {% include "portada.njk" %}
  {% else %}
  <div class="cabecera-pagina">
    <div class="contenedor">
      {% if migas %}<p class="migas"><a href="{{ migas.url }}">{{ migas.titulo }}</a> /</p>{% endif %}
      <h1>{{ cabecera or title }}</h1>
      {% if entradilla %}<p class="entradilla">{{ entradilla }}</p>{% endif %}
    </div>
  </div>
  {% endif %}

  {% if subsecciones %}
  <nav class="subsecciones" aria-label="En esta página">
    <ul class="contenedor subsecciones__lista">
      {% for s in subsecciones %}<li><a href="#{{ s.id }}">{{ s.titulo }}</a></li>{% endfor %}
    </ul>
  </nav>
  {% endif %}

  <main id="contenido" class="contenedor contenido">
    {{ content | safe }}
  </main>

  <footer class="pie">
    <div class="contenedor pie__rejilla">
      <div>
        <p class="pie__nombre">{{ site.nombre }}</p>
        <p>{{ site.lema }} · Archidiócesis de Oviedo</p>
      </div>
      <ul class="pie__enlaces">
        {% for item in navegacion %}<li><a href="{{ item.url }}">{{ item.titulo }}</a></li>{% endfor %}
      </ul>
      <div class="pie__legal">
        <p><a href="/aviso-legal/">Aviso legal</a> · <a href="/privacidad/">Privacidad y cookies</a></p>
        <p>Esta web no usa cookies ni recoge datos personales.</p>
        <p>© {{ build.year }} {{ site.nombre }}</p>
      </div>
    </div>
  </footer>
</body>
</html>
