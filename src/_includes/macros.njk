{# Recuadro para contenido que aún falta por completar. #}
{% macro pendiente(texto) -%}
<p class="pendiente"><span class="pendiente__etiqueta">Pendiente</span> {{ texto }}</p>
{%- endmacro %}

{# Pequeño dibujo de iglesia, usado como marca y como hueco de foto. #}
{% macro iglesia(clase="") -%}
<svg class="{{ clase }}" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <path d="M32 4v8M28 8h8" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none"/>
  <path d="M24 26 32 14l8 12v8H24z" fill="currentColor"/>
  <path d="M8 60V38l16-10v32zM40 28l16 10v22H40z" fill="currentColor" opacity=".7"/>
  <path d="M22 60V32h20v28h-6V48a4 4 0 0 0-8 0v12z" fill="currentColor"/>
</svg>
{%- endmacro %}

{# Una hora con todas las misas que coinciden a esa hora, una al lado de otra. #}
{% macro filaHora(grupo, parroquias) -%}
<li class="misa">
  <span class="misa__hora">{{ grupo.hora }}</span>
  <span class="misa__lugares">
    {%- for misa in grupo.misas %}
    {% set p = parroquias | porSlug(misa.parroquia) %}
    <a class="lugar" href="/parroquias/{{ p.slug }}/">{{ p.nombre }}{% if misa.lugar %}<small>{{ misa.lugar }}</small>{% endif %}</a>
    {%- endfor %}
  </span>
</li>
{%- endmacro %}

{# Dentro de una parroquia: «De lunes a viernes · 19:30 · Capilla…». #}
{% macro filaResumen(r) -%}
<li class="misa misa--resumen">
  <span class="misa__dia">{{ r.diasTexto }}</span>
  <span class="misa__hora">{{ r.hora }}</span>
  {%- if r.lugar %}<span class="misa__sitio">{{ r.lugar }}</span>{% endif %}
</li>
{%- endmacro %}
