---
layout: base.njk
title: Horarios de misa
seccion: horarios
entradilla: Misas entre semana, de sábado por la tarde y de domingo en las parroquias de la Unidad Pastoral.
subsecciones:
  - { id: fin-de-semana, titulo: Fin de semana }
  - { id: diario, titulo: Entre semana }
  - { id: especiales, titulo: Horarios especiales }
---
{% import "macros.njk" as m %}

<p class="aviso-horario">{{ misas.aviso }}</p>

<section id="fin-de-semana" class="seccion">
  <h2>Fin de semana</h2>
  <p class="nota nota--arriba">Las misas que coinciden a la misma hora aparecen juntas en la misma fila.</p>
  <div class="columnas">
    {% for dia in ["sabado", "domingo"] %}
    <div class="caja">
      <h3>{{ dia | diaNombre }}{% if dia == "sabado" %} <span class="sufijo">por la tarde</span>{% endif %}</h3>
      <ul class="misas">
        {% for grupo in misasLista | misasDia(dia) | agruparHora %}{{ m.filaHora(grupo, parroquias) }}{% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
</section>

<section id="diario" class="seccion">
  <h2>Entre semana</h2>
  {% set diario = misasLista | laborables | resumenDias %}
  {% if diario | length %}
  <div class="caja">
    <ul class="misas">
      {% for r in diario %}
      {% set p = parroquias | porSlug(r.parroquia) %}
      <li class="misa misa--resumen">
        <span class="misa__dia">{{ r.diasTexto }}</span>
        <span class="misa__hora">{{ r.hora }}</span>
        <span class="misa__sitio"><a href="/parroquias/{{ p.slug }}/">{{ p.nombre }}</a>{% if r.lugar %} · {{ r.lugar }}{% endif %}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% else %}
  {{ m.pendiente("Horario de misas de lunes a viernes.") }}
  {% endif %}
</section>

<section id="especiales" class="seccion">
  <h2>Horarios especiales</h2>
  {% if misas.especiales | length %}
  <ul class="lista-simple">
    {% for e in misas.especiales %}<li><strong>{{ e.titulo }}</strong> — {{ e.texto }}</li>{% endfor %}
  </ul>
  {% else %}
  {{ m.pendiente("Cambios de horario de verano, Navidad, Semana Santa y fiestas patronales.") }}
  {% endif %}
</section>
