---
layout: base.njk
seccion: parroquias
pagination:
  data: parroquias
  size: 1
  alias: p
permalink: "/parroquias/{{ p.slug }}/"
migas: { titulo: Parroquias, url: /parroquias/ }
eleventyComputed:
  title: "{{ p.nombre }}"
  cabecera: "Parroquia de {{ p.nombre }}"
  entradilla: "{{ p.templo }}"
subsecciones:
  - { id: horario, titulo: Horario }
  - { id: pueblo, titulo: El pueblo }
  - { id: templo, titulo: El templo }
  - { id: como-llegar, titulo: Cómo llegar }
---
{% import "macros.njk" as m %}
{% set suyas = misasLista | misasDe(p.slug) | resumenDias %}
{% set busqueda = "Iglesia " ~ p.nombre ~ ", Piloña, Asturias" %}

<figure class="foto-ficha">
  {% if p.foto %}
  <img src="{{ p.foto }}" alt="Iglesia de {{ p.nombre }}">
  {% if p.fotoCredito %}<figcaption>{{ p.fotoCredito }}</figcaption>{% endif %}
  {% else %}
  <span class="foto-vacia foto-vacia--grande">{{ m.iglesia() }}<span>Foto pendiente</span></span>
  {% endif %}
</figure>

<section id="horario" class="seccion">
  <h2>Horario de misas</h2>
  {% if suyas | length %}
  <ul class="misas">{% for r in suyas %}{{ m.filaResumen(r) }}{% endfor %}</ul>
  {% else %}
  <p>No hay misa fija. Consulte los <a href="/horarios/">horarios de toda la Unidad Pastoral</a>.</p>
  {% endif %}
  <p class="nota">{{ misas.aviso }}</p>
</section>

<section id="pueblo" class="seccion">
  <h2>El pueblo</h2>
  {% if p.pueblo %}<p>{{ p.pueblo }}</p>{% else %}{{ m.pendiente("Unas líneas sobre " ~ p.nombre ~ ": dónde está, cómo es y qué lo caracteriza.") }}{% endif %}
  {% if p.historia %}<h3>Historia</h3><p>{{ p.historia }}</p>{% endif %}
</section>

<section id="templo" class="seccion">
  <h2>El templo</h2>
  <dl class="datos">
    <dt>Iglesia</dt><dd>{{ p.templo or "Pendiente" }}</dd>
    <dt>Advocación</dt><dd>{{ p.advocacion or "Pendiente" }}</dd>
    <dt>Fiestas</dt><dd>{{ p.fiestas or "Pendiente" }}</dd>
  </dl>
</section>

<section id="como-llegar" class="seccion">
  <h2>Cómo llegar</h2>
  {% if p.direccion %}<p>{{ p.direccion }}</p>{% endif %}
  <p class="botones-mapa">
    <a class="boton" href="{{ p.mapa or (busqueda | mapaUrl) }}" rel="noopener">Ver la iglesia en Google Maps</a>
    {% for r in suyas %}{% if r.lugar %}
    <a class="boton boton--borde" href="{{ (r.lugar ~ ', ' ~ p.nombre ~ ', Asturias') | mapaUrl }}" rel="noopener">{{ r.lugar }}</a>
    {% endif %}{% endfor %}
  </p>
</section>
